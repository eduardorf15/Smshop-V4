PORT=3000

# Optional. Public Mercado Livre item data works without a token for many products.
# Add a token only if you need authenticated quota/endpoints. Never expose this in frontend code.
MERCADO_LIVRE_ACCESS_TOKEN=

# Mercado Livre product cache TTL. Default: 6 hours.
MELI_CACHE_TTL_MS=21600000
PRODUCT_CACHE_TTL_MS=21600000

# Optional. If set, POST /api/products/cache/refresh must send this value in x-cache-token.
PRODUCT_CACHE_REFRESH_TOKEN=
